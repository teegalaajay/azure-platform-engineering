#cloud-config
# Rendered by Terraform templatefile(). Dollar-brace is Terraform interpolation, so every
# shell variable below is written as $NAME without braces.
write_files:
  - path: /root/runner-registration-token
    owner: root:root
    permissions: "0600"
    content: "${registration_token}"
  - path: /opt/runner-bootstrap.sh
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      RUNNER_VERSION="${runner_version}"
      RUNNER_SHA256="${runner_sha256}"
      TERRAFORM_VERSION="${terraform_version}"
      REPO_URL="${repo_url}"
      RUNNER_NAME="${runner_name}"
      RUNNER_LABELS="${labels}"

      apt-get update
      apt-get install -y ca-certificates curl gnupg jq unzip
      install -d -m 755 /etc/apt/keyrings

      # Keep ONLY the expected key in the keyring, then re-read it and compare fingerprints.
      add_key() {
        local name="$1" url="$2" fpr="$3" tmp got
        tmp=$(mktemp -d)
        curl -fsSL "$url" -o "$tmp/key.asc"
        gpg --homedir "$tmp" --no-default-keyring --keyring "$tmp/in.kbx" --import "$tmp/key.asc"
        gpg --homedir "$tmp" --no-default-keyring --keyring "$tmp/in.kbx" --export "$fpr" > "/etc/apt/keyrings/$name.gpg"
        got=$(gpg --show-keys --with-colons "/etc/apt/keyrings/$name.gpg" | awk -F: '$1=="fpr"{print $10; exit}')
        if [ "$got" != "$fpr" ]; then
          echo "key fingerprint mismatch for $name: got [$got]" >&2
          exit 1
        fi
        chmod 644 "/etc/apt/keyrings/$name.gpg"
        rm -rf "$tmp"
      }

      ARCH=$(dpkg --print-architecture)
      . /etc/os-release
      add_key microsoft https://packages.microsoft.com/keys/microsoft.asc BC528686B50D79E339D3721CEB3E94ADBE1229CF
      add_key hashicorp https://apt.releases.hashicorp.com/gpg D55C0D1AC78A8D8126CB631CFC9CA96ACA026560
      echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ $VERSION_CODENAME main" > /etc/apt/sources.list.d/azure-cli.list
      echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $VERSION_CODENAME main" > /etc/apt/sources.list.d/hashicorp.list
      apt-get update
      apt-get install -y azure-cli "terraform=$TERRAFORM_VERSION-1"
      apt-mark hold terraform

      id runner >/dev/null 2>&1 || useradd --create-home --shell /bin/bash --user-group runner
      install -d -o runner -g runner -m 755 /opt/actions-runner
      cd /opt/actions-runner
      curl -fsSL -o runner.tar.gz "https://github.com/actions/runner/releases/download/v$RUNNER_VERSION/actions-runner-linux-x64-$RUNNER_VERSION.tar.gz"
      echo "$RUNNER_SHA256  runner.tar.gz" | sha256sum -c -
      tar xzf runner.tar.gz
      rm runner.tar.gz
      chown -R runner:runner /opt/actions-runner
      ./bin/installdependencies.sh

      TOKEN=$(cat /root/runner-registration-token)
      runuser -u runner -- env HOME=/home/runner ./config.sh --unattended --ephemeral \
        --url "$REPO_URL" --token "$TOKEN" --name "$RUNNER_NAME" --labels "$RUNNER_LABELS" --work _work
      rm -f /root/runner-registration-token

      ./svc.sh install runner
      ./svc.sh start
      touch /var/lib/runner-bootstrap.done

runcmd:
  - [bash, /opt/runner-bootstrap.sh]
